{
  "name": "superdaw",
  "version": "0.2.0",
  "description": "AI-driven Audio DAW for Podcast Production",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0",
    "wavesurfer.js": "^7.8.0",
    "tone": "^15.0.4",
    "openai": "^4.52.0",
    "@xenova/transformers": "^2.17.0",
    "lamejs": "^1.2.1",
    "uuid": "^9.0.0",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "eslint": "^9.6.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
